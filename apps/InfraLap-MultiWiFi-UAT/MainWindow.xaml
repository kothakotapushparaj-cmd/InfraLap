<Window x:Class="InfraLap.MultiWiFi.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="InfraLap MultiWiFi" Height="760" Width="1120" MinHeight="640" MinWidth="900"
 Background="#101827" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F6FC"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#5B91FF"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#24344E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#405474"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="INFRALAP SOLUTIONS" Foreground="#78A7FF" FontSize="12" FontWeight="Bold"/>
    <TextBlock Text="MultiWiFi Manager" FontSize="28" FontWeight="Bold" Margin="0,3,0,0"/>
    <TextBlock Text="Phase A hardware discovery and saved-profile connection UAT" Foreground="#A9B7CC" FontSize="12"/>
   </StackPanel>
   <Border DockPanel.Dock="Right" Background="#173B34" CornerRadius="10" Padding="12,7" VerticalAlignment="Center">
    <TextBlock Text="UAT BUILD 0.4" Foreground="#83E0B7" FontSize="11" FontWeight="Bold"/>
   </Border>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="Refresh Wi-Fi" Click="Refresh_Click"/>
   <Button Content="Show Drivers" Click="Drivers_Click" Background="#34445F"/>
   <Button Content="Connect saved profile" Click="Connect_Click"/>
   <Button Content="Disconnect" Click="Disconnect_Click" Background="#A94B55"/>
   <Button Content="Export diagnostics" Click="Export_Click" Background="#34445F"/>
  </WrapPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#1B2940" CornerRadius="12" Padding="16" Margin="0,0,12,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="NETWORK INTERFACES" FontWeight="Bold" Foreground="#A9B7CC" Margin="0,0,0,10"/>
     <ListBox x:Name="InterfacesList" Background="#172338" Foreground="White" BorderThickness="0" SelectionChanged="InterfacesList_SelectionChanged"/>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="Saved Wi-Fi profile name" Foreground="#A9B7CC" FontSize="12" Margin="0,0,0,5"/>
      <TextBox x:Name="ProfileNameBox" Text=""/>
      <TextBlock Text="Selected interface" Foreground="#A9B7CC" FontSize="12" Margin="0,10,0,5"/>
      <TextBox x:Name="InterfaceNameBox" IsReadOnly="True"/>
      <TextBlock Text="Connection uses a profile already saved in Windows. This prototype does not collect or store Wi-Fi passwords."
       Foreground="#A9B7CC" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="#1B2940" CornerRadius="12" Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="AVAILABLE WI-FI NETWORKS" FontWeight="Bold" FontSize="15"/>
      <TextBlock Text="Detected SSIDs and signal information from Windows WLAN scan" Foreground="#A9B7CC" FontSize="11" Margin="0,4,0,0"/>
     </StackPanel>
     <TextBox x:Name="NetworksOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#172338" CornerRadius="8" Padding="11" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" Text="Ready. Select Refresh Wi-Fi to scan." Foreground="#A9B7CC" FontSize="12"/>
  </Border>
 </Grid>
</Window>
