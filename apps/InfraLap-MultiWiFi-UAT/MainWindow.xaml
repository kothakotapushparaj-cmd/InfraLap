<Window x:Class="InfraLap.MultiWiFi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfraLap MultiWiFi" Height="1000" Width="1280"
        MinHeight="920" MinWidth="1100"
        Background="#101827" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B2940"/>
        <SolidColorBrush x:Key="InputBrush" Color="#24344E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A9B7CC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B91FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F6FC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#405474"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#405474"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#172338"/>
            <Setter Property="BorderBrush" Value="#405474"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="INFRALAP SOLUTIONS" FontSize="12" FontWeight="Bold" Foreground="#78A7FF"/>
                <TextBlock Text="MultiWiFi Manager" FontSize="29" FontWeight="Bold" Margin="0,3,0,0"/>
                <TextBlock Text="Wi-Fi profiles · Saved networks · Password reveal · Dual-STA readiness"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#173B34" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                <TextBlock Text="V0.8 · SCAN-TO-SELECT SSID UAT" Foreground="#83E0B7" FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button Content="Refresh Wi-Fi adapters" Click="Refresh_Click"/>
            <Button Content="Scan nearby networks" Click="Scan_Click" Background="#34445F"/>
            <Button Content="Refresh saved profiles" Click="SavedProfiles_Click" Background="#34445F"/>
            <Button Content="Export diagnostics" Click="Export_Click" Background="#34445F" Margin="0"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14"
                    Padding="18" Margin="0,0,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,17">
                        <StackPanel>
                            <TextBlock Text="CONNECTION 1" Foreground="#78A7FF" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Primary Wi-Fi profile" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#263A5A" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="PROFILE 01" Foreground="#BDD2FF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Wi-Fi adapter" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Connection1Adapter" Height="36" DisplayMemberPath="DisplayText"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Choose nearby network (SSID)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Connection1Ssid" Height="37" IsEditable="True"
                                  IsTextSearchEnabled="True" TextSearch.TextPath="Ssid"
                                  StaysOpenOnEdit="False"
                                  ToolTip="Select a scanned network from the list, or type a hidden SSID manually">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,2">
                                        <TextBlock Text="{Binding Ssid}" Foreground="#F3F6FC" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DetailText}" Foreground="#A9B7CC" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <TextBlock Text="Wi-Fi password" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="Connection1Password" Height="37"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="4" Margin="0,0,0,12">
                        <Button Content="Connect 1" Click="Connect1_Click"/>
                        <Button Content="Disconnect 1" Click="Disconnect1_Click" Background="#A94B55" Margin="0"/>
                    </WrapPanel>
                    <Border Grid.Row="5" Background="#172338" CornerRadius="8" Padding="11">
                        <StackPanel>
                            <TextBlock Text="CONNECTION STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="Connection1Status" Text="Not connected" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="6" Text="Credentials are imported into the current Windows user Wi-Fi profile. InfraLap does not save them in its own settings."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,13,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14"
                    Padding="18" Margin="10,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,17">
                        <StackPanel>
                            <TextBlock Text="CONNECTION 2" Foreground="#83DDB5" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Secondary Wi-Fi profile" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#173B34" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="PROFILE 02" Foreground="#A9F0D1" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Wi-Fi adapter" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Connection2Adapter" Height="36" DisplayMemberPath="DisplayText"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Network name (SSID)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="Connection2Ssid" Height="37" IsEditable="True"
                                  IsTextSearchEnabled="True" TextSearch.TextPath="Ssid"
                                  StaysOpenOnEdit="False"
                                  ToolTip="Select a scanned network from the list, or type a hidden SSID manually">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,2">
                                        <TextBlock Text="{Binding Ssid}" Foreground="#F3F6FC" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DetailText}" Foreground="#A9B7CC" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <TextBlock Text="Wi-Fi password" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="Connection2Password" Height="37"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="4" Margin="0,0,0,12">
                        <Button Content="Connect 2" Click="Connect2_Click"/>
                        <Button Content="Try same-adapter SSID (experimental)" Click="TrySecondarySta_Click"
                                Background="#8B6E30"/>
                        <Button Content="Stop secondary STA" Click="StopSecondarySta_Click"
                                Background="#A94B55" Margin="0"/>
                    </WrapPanel>
                    <Border Grid.Row="5" Background="#172338" CornerRadius="8" Padding="11">
                        <StackPanel>
                            <TextBlock Text="CONNECTION STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="Connection2Status" Text="Not connected" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="6" Text="Experimental: attempts WlanConnect on the driver-exposed secondary STA. Windows normally synchronizes this link with the primary; only a verified different SSID counts as success."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,13,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="#172338" CornerRadius="10" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="HARDWARE READINESS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="HardwareStatus" Text="Checking wireless adapters..." FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="#172338" CornerRadius="10" Padding="12" Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NEARBY WI-FI NETWORKS · SELECT FROM SSID DROPDOWN" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="NetworksOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="10" Background="#101827" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}"
                    CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="SAVED WINDOWS WI-FI PROFILES" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                        <DataGrid x:Name="SavedProfilesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectionChanged="SavedProfilesGrid_SelectionChanged"
                                  Background="#101827" Foreground="#F3F6FC"
                                  RowBackground="#172338" AlternatingRowBackground="#1B2940"
                                  BorderBrush="#405474" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Network (SSID)" Binding="{Binding Ssid}" Width="*"/>
                                <DataGridTextColumn Header="Adapter" Binding="{Binding AdapterName}" Width="110"/>
                                <DataGridTextColumn Header="Security" Binding="{Binding Authentication}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SELECTED NETWORK" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,7"/>
                        <TextBlock x:Name="SavedProfileDetails" Text="Select a saved network to view its details."
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="SavedPasswordHidden" Height="34" IsEnabled="True"
                                     IsHitTestVisible="False" Focusable="False"
                                     ToolTip="Saved password is hidden by default"/>
                        <TextBox x:Name="SavedPasswordVisible" Height="34" IsReadOnly="True"
                                 Visibility="Collapsed" Background="#24344E" Foreground="White"
                                 BorderBrush="#405474" Padding="9,7"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="SavedPasswordToggle" Content="Show password" Click="ToggleSavedPassword_Click"
                                    Background="#34445F" IsEnabled="False"/>
                            <Button Content="Use in Connection 1" Click="UseSavedForConnection1_Click" Background="#34445F"/>
                            <Button Content="Use in Connection 2" Click="UseSavedForConnection2_Click" Background="#34445F" Margin="0"/>
                        </WrapPanel>
                        <TextBlock x:Name="SavedPasswordStatus"
                                   Text="Passwords remain hidden until you choose Show password. Plain-text access is controlled by Windows."
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#172338" CornerRadius="8" Padding="11" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Ready. Refresh Wi-Fi adapters to begin." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
