<Window x:Class="InfraLap.MultiWiFi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InfraLap MultiWiFi — Adapter Control Center"
        Height="1040" Width="1460" MinHeight="820" MinWidth="1120"
        Background="#09111F" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111E31"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0B1728"/>
        <SolidColorBrush x:Key="LineBrush" Color="#293D59"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EDF3FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A3BB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5797FF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#54D6A2"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F0B86A"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#233650"/>
            <Setter Property="BorderBrush" Value="#385372"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#873D4C"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#344B6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#344B6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#344B6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#172338"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#DCEBFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#C7DCFA"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B2D46"/>
            <Setter Property="Foreground" Value="#C9D8EC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="#344A69"/>
        </Style>
        <DataTemplate x:Key="NetworkItemTemplate">
            <StackPanel Margin="3,2">
                <TextBlock Text="{Binding Ssid}" Foreground="#172338" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DetailText}" Foreground="#52647D" FontSize="9" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WIRELESS NETWORK CONTROL" Foreground="#80B1FF" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="MultiWiFi Adapter Control Center" FontSize="27" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock Text="Detect every Windows Wi-Fi interface. Assign a network to each physical adapter and manage connections independently."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="None" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#17362F" BorderBrush="#2A7057" BorderThickness="1"
                    CornerRadius="9" Padding="13,9" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="BUILD" Foreground="#98E0C2" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="1.1 · MULTI-ADAPTER" Foreground="#D0F5E5" FontSize="10" FontWeight="Bold"
                               Margin="0,3,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,15">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="25" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="Adapter and network tools" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Refresh adapters" Click="Refresh_Click"/>
                    <Button Content="Scan networks" Click="Scan_Click" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Refresh saved profiles" Click="SavedProfiles_Click" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="Export diagnostics" Click="Export_Click" Style="{StaticResource SecondaryButton}" Margin="0"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,4">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="WI-FI ADAPTERS DETECTED" Foreground="#80B1FF" FontSize="8" FontWeight="Bold"/>
                            <TextBlock x:Name="AdapterCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock Text="Each detected interface gets its own connection card." Foreground="{StaticResource MutedBrush}"
                                       FontSize="9" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE WI-FI LINKS" Foreground="#63D8B4" FontSize="8" FontWeight="Bold"/>
                            <TextBlock x:Name="ConnectedCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock Text="Connected status is read back from Windows." Foreground="{StaticResource MutedBrush}"
                                       FontSize="9" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SAVED WI-FI PROFILES" Foreground="#E5B873" FontSize="8" FontWeight="Bold"/>
                            <TextBlock x:Name="SavedProfilesCountText" Text="0" FontSize="23" FontWeight="Bold" Margin="0,3,0,0"/>
                            <TextBlock Text="Stored by Windows for the current device." Foreground="{StaticResource MutedBrush}"
                                       FontSize="9" TextWrapping="Wrap" TextTrimming="None"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="PHYSICAL WI-FI INTERFACES" Foreground="#80B1FF" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="One connection workspace per adapter" FontSize="17" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#1B2E48" CornerRadius="7" Padding="8,5" VerticalAlignment="Center">
                                <TextBlock Text="DYNAMIC ADAPTER LIST" Foreground="#C3D7F0" FontSize="8" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Identical adapter models are distinguished by Windows interface name, MAC address, interface GUID and Plug-and-Play device ID."
                                   Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AdapterEmptyText"
                                   Text="No WLAN adapters detected yet. Connect your USB Wi-Fi adapter, then select Refresh adapters."
                                   Foreground="{StaticResource AmberBrush}" FontSize="11" TextWrapping="Wrap" TextTrimming="None"
                                   Margin="2,6,2,8" Visibility="Visible"/>
                        <WrapPanel x:Name="AdapterCardsPanel"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="HARDWARE READINESS" Foreground="#80B1FF" FontSize="8" FontWeight="Bold"/>
                            <TextBlock Text="Adapter inventory" FontSize="15" FontWeight="Bold" Margin="0,3,0,8"/>
                            <TextBlock x:Name="HardwareStatus" Text="Waiting for Windows wireless interfaces..."
                                       Foreground="#C9D7E9" FontSize="10" TextWrapping="Wrap" TextTrimming="None"/>
                            <TextBlock Text="A USB hub adds ports, not Wi-Fi radios. Each compatible USB Wi-Fi adapter should appear as another interface."
                                       Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"
                                       TextTrimming="None" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="14" Margin="7,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock Text="WIRELESS ENVIRONMENT" Foreground="#63D8B4" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock Text="Nearby networks" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Text="SCAN RESULTS" Foreground="{StaticResource MutedBrush}" FontSize="8"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="NetworksOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="9" Background="{StaticResource InputBrush}"
                                     BorderBrush="{StaticResource LineBrush}" Height="148"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="WINDOWS WLAN PROFILE LIBRARY" Foreground="#E5B873" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Text="Saved networks and credentials" FontSize="17" FontWeight="Bold" Margin="0,3,0,0"/>
                                <TextBlock Text="Select a saved WPA2 profile and load it into any selected detected adapter."
                                           Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"
                                           TextTrimming="None" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Reload profiles" Click="SavedProfiles_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <DataGrid x:Name="SavedProfilesGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="SavedProfilesGrid_SelectionChanged"
                                      Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                                      RowBackground="#14233A" AlternatingRowBackground="#192B44"
                                      BorderBrush="{StaticResource LineBrush}" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                                      FontSize="10" Height="220" Margin="0,0,10,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NETWORK / SSID" Binding="{Binding Ssid}" Width="*"/>
                                    <DataGridTextColumn Header="ADAPTER" Binding="{Binding AdapterName}" Width="110"/>
                                    <DataGridTextColumn Header="SECURITY" Binding="{Binding Authentication}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Column="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="SELECTED PROFILE" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock x:Name="SavedProfileDetails" Text="Select a saved network to view its details."
                                               FontSize="10" TextWrapping="Wrap" TextTrimming="None" Margin="0,7,0,9"/>
                                    <PasswordBox x:Name="SavedPasswordHidden" Height="34" IsHitTestVisible="False" Focusable="False"/>
                                    <TextBox x:Name="SavedPasswordVisible" Height="34" IsReadOnly="True" Visibility="Collapsed"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="SavedPasswordToggle" Content="Show password" Click="ToggleSavedPassword_Click"
                                                Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                                        <Button Content="Load into selected adapter" Click="UseSavedProfile_Click"
                                                Style="{StaticResource SecondaryButton}" Margin="0"/>
                                    </WrapPanel>
                                    <TextBlock Text="TARGET ADAPTER" Foreground="{StaticResource MutedBrush}" FontSize="8"
                                               FontWeight="Bold" Margin="0,10,0,5"/>
                                    <ComboBox x:Name="SavedTargetAdapter" Height="36" DisplayMemberPath="DisplayText"/>
                                    <TextBlock x:Name="SavedPasswordStatus"
                                               Text="Passwords stay hidden until you select Show password. Windows controls plain-text access."
                                               Foreground="{StaticResource MutedBrush}" FontSize="9"
                                               TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="InfraLap MultiWiFi · Windows 11 x64 · Separate physical WLAN interfaces · No bandwidth bonding"
                           Foreground="#71839C" FontSize="8" HorizontalAlignment="Center" Margin="0,7,0,9"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#111E31" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,11,0,0">
            <DockPanel>
                <Border Width="7" Height="7" Background="{StaticResource GreenBrush}" CornerRadius="4"
                        VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="ACTIVITY" Foreground="{StaticResource MutedBrush}" FontSize="8" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                <TextBlock x:Name="StatusText" Text="Ready. Refresh Wi-Fi adapters to begin."
                           Foreground="#D0DCEF" FontSize="9" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>